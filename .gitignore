# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Dependency / build outputs
node_modules/
dist/
build/
coverage/
.turbo/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# IDE/editor local state
.vscode/
.idea/

# Runtime/cache/temp
.tmp/
tmp/
.cache/
.chrome-profile/
.playwright-browsers/
.playwright-mcp/
*.zip

# Generated QA artifact outputs
outputs/webwright_view_settings_*/
qa-output/

# Scene-understanding generated bakeoff runs
experiments/scene_understanding/outputs/stack_*/
experiments/scene_understanding/outputs/semantic_tasks/

# Local snapshot captures
sentineltwin-*.png
sentinel-novel-*.png
novel-*.png
*-open-studio.png
studio-wait-*.png
studio-build-error.png

# Agent-local docs/state (optional to version, excluded by default)
.agent/

# AI-generated screenshot artifacts
.codex-studio-home-*.png

# Studio local runtime archives/state
apps/studio/.governance-archive/
apps/studio/.support-delivery/
apps/studio/.support-ingest/
apps/studio/.workspace-membership-archive/

# TypeScript build info
*.tsbuildinfo
.sentineltwin-backend/
.sentinel-reset-lock
bin/

# ML model files (operator-provisioned, not bundled in source control).
# Onnxruntime-web and other ML backends fetch these at runtime from
# /public/models/* paths. Keep the directories; ignore the binaries.
apps/studio/public/models/**/*.onnx
apps/studio/public/models/**/*.bin
apps/studio/public/models/**/*.pt
apps/studio/public/models/**/*.safetensors
apps/studio/public/models/**/*.tflite

# Local agent/skill caches (not source)
.codexx/
