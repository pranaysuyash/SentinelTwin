{
  "name": "studio",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node ./scripts/run-fixed-port.mjs dev",
    "dev:turbopack": "STUDIO_DEV_BUNDLER=turbopack node ./scripts/run-fixed-port.mjs dev",
    "dev:webpack": "STUDIO_DEV_BUNDLER=webpack node ./scripts/run-fixed-port.mjs dev",
    "build": "rm -rf .next && NEXT_PRIVATE_WORKER_THREADS=false next build --turbopack --experimental-app-only",
    "start": "node ./scripts/run-fixed-port.mjs start",
    "clean": "rm -rf .next",
    "lint": "eslint",
    "audit:truth": "bun ../../tools/truth-audit.ts",
    "trust-audit": "bun run audit:truth",
    "quality:gate": "bash ../../tools/studio-quality-gate.sh",
    "hex:check": "bun ../../tools/hex-drift-detect.ts",
    "hex:update": "bun ../../tools/hex-drift-detect.ts --update",
    "deploy:validate": "node ./scripts/validate-deploy-profile.mjs local-only",
    "deploy:validate:self-hosted": "node ./scripts/validate-deploy-profile.mjs self-hosted",
    "deploy:validate:cloud-assisted": "node ./scripts/validate-deploy-profile.mjs cloud-assisted",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@sentineltwin/agents": "workspace:*",
    "@sentineltwin/core": "workspace:*",
    "@sentineltwin/report": "workspace:*",
    "@sentineltwin/simulation": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "onnxruntime-web": "^1.26.0",
    "pdf-lib": "^1.17.1",
    "postprocessing": "^6.39.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.10",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4.3.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "dompurify": "^3.4.9",
    "postcss": "^8.5.15"
  },
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f"
}
