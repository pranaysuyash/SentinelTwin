{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@sentineltwin/core": ["./src/index.ts"],
      "@sentineltwin/core/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
