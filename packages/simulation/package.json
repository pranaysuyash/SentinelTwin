  "dependencies": {
    "@sentineltwin/core": "workspace:*",
    "three": "^0.184.0",
    "three-mesh-bvh": "^0.9.10"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/three": "^0.184.1",
    "typescript": "^5"
  }
