#!/usr/bin/env bash
# Shared Webwright/Python QA environment contract for SentinelTwin.
# Reuse these values across all agents and sessions.

export WEBWRIGHT_PYTHON_BIN=python3.13
export WEBWRIGHT_VENV_PATH=/tmp/webwright-sentinel
export WEBWRIGHT_UV_CACHE_DIR=/private/tmp/uv-cache
export PLAYWRIGHT_CACHE_DIR=/private/tmp/ms-playwright
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_CACHE_DIR}"
export MSWEBA_GLOBAL_CONFIG_DIR=/private/tmp/webwright-config
